# Public Supabase values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace_in_server_environment_only

# Random secret >= 16 characters; Vercel sends it to private extraction and AI-retention cron routes.
CRON_SECRET=replace_in_server_environment_only

# AI gateway (server-only). Select exactly one answer provider and configure its key.
# Suggested low-cost start: openrouter + openrouter/free, or gemini + gemini-3.1-flash-lite.
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free

# OPENAI_API_KEY is also required for semantic document embeddings even when another answer provider is selected.
OPENAI_API_KEY=replace_in_server_environment_only
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_API_KEY=replace_in_server_environment_only
GEMINI_API_KEY=replace_in_server_environment_only
DEEPSEEK_API_KEY=replace_in_server_environment_only
NVIDIA_NIM_API_KEY=replace_in_server_environment_only
